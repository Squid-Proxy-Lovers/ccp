#!/bin/sh
set -eu

DEFAULT_SERVER_URL="http://127.0.0.1:1338"
SERVER_URL="${CCP_SERVER_URL:-$DEFAULT_SERVER_URL}"
SERVER_URL="${SERVER_URL%/}"


usage() {
    echo "Usage: ccp-manage add <session> | delete <session> | stats <session>" >&2
    exit 64
}

if [ "$#" -eq 0 ]; then
    if command -v open >/dev/null 2>&1; then open "$SERVER_URL/admin"
    elif command -v xdg-open >/dev/null 2>&1; then xdg-open "$SERVER_URL/admin"
    else echo "$SERVER_URL/admin"
    fi
    exit 0
fi
[ "$#" -eq 2 ] || usage
: "${CCP_ADMIN_KEY:?Set CCP_ADMIN_KEY to the server admin key}"
ADMIN_KEY="$CCP_ADMIN_KEY"
command_name="$1"
session="$2"
command -v python3 >/dev/null 2>&1 || { echo "python3 is required" >&2; exit 1; }
encoded=$(python3 -c 'import sys, urllib.parse; print(urllib.parse.quote(sys.argv[1], safe=""))' "$session")

case "$command_name" in
    add)
        payload=$(python3 -c 'import json, sys; print(json.dumps({"session_name": sys.argv[1]}))' "$session")
        curl -fsS -X POST \
            -H "Content-Type: application/json" \
            -H "X-CCP-Admin-Key: $ADMIN_KEY" \
            --data "$payload" \
            "$SERVER_URL/v1/admin/sessions"
        ;;
    delete)
        curl -fsS -X DELETE \
            -H "X-CCP-Admin-Key: $ADMIN_KEY" \
            "$SERVER_URL/v1/admin/sessions/$encoded"
        ;;
    stats)
        curl -fsS \
            -H "X-CCP-Admin-Key: $ADMIN_KEY" \
            "$SERVER_URL/v1/admin/sessions/$encoded/stats"
        ;;
    *) usage ;;
esac
printf '\n'
